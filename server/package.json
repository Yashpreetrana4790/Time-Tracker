{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node init && prisma generate && prisma db push --skip-generate && tsx src/seed.ts && tsx watch src/index.ts",
    "start": "node init && tsx src/index.ts",
    "db:reset": "prisma db push --force-reset --skip-generate && tsx src/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "prisma": "6.19.3",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
